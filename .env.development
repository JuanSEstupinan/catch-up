# Environment: Development
# Description: This file contains environment variables for the development environment.
# Note: In real scenarios, this file should not be committed to version control for security reasons.

# VITE_NEWS_API_KEY is the API key for accesing the News API in the development environment.
VITE_NEWS_API_KEY=your_development_api_key_here
# VITE_NEWS_API_URL is the base URL for the News API in the development environment
VITE_NEWS_API_URL=https://newsapi.org/v2
# VITE_LOGO_API_URL is the base URL for the Logo API in the development environment.
VITE_LOGO_API_URL=https://img.logo.dev
# VITE_LOGO_PUBLISHABLE_API_KEY is the publishable API key for accessing the Logo API in the development environment.
VITE_LOGO_PUBLISHABLE_API_KEY=your_logo_api_key_here
# VITE_SOURCES_ENDPOINT_PATH is the endpoint path for the sources in the development environment.
VITE_SOURCES_ENDPOINT_PATH=/top-headlines/sources
# VITE_TOP_HEADLINES_ENDPOINT_PATH is the endpoint path for the top headlines in the development environment.
VITE_TOP_HEADLINES_ENDPOINT_PATH=/top-headlines
# VITE_PRIME_UIT_LICENSE_KEY is the license key for he Prime UI in the development environment.
VITE_PRIME_UIT_LICENSE_KEY=your_prime_ui_license_key_here